# Ambiente
NODE_ENV=production
LOG_LEVEL=debug

# Servidor
PORT=10000

# Banco de dados (PostgreSQL para produção)
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# Facebook API - Configuração Global
FB_API_URL=https://graph.facebook.com/v18.0
FB_PIXEL_ID=your_pixel_id_here
FB_ACCESS_TOKEN=your_facebook_access_token_here

# Configurações do site
SHOPIFY_DOMAIN=your-store.myshopify.com

# Render
RENDER_EXTERNAL_URL=https://your-app.onrender.com

# GeoIP
GEOIP_DB_PATH=data/GeoLite2-City.mmdb

# Configurações GeoIP MaxMind
MAXMIND_ACCOUNT_ID=your_maxmind_account_id
MAXMIND_LICENSE_KEY=your_maxmind_license_key

# Redis (Cloud)
REDIS_HOST=your-redis-host.com
REDIS_PORT=6379
REDIS_DATABASE_NAME=0
REDIS_PASSWORD=your_redis_password
REDIS_USERNAME=default

# Configurações da fila
QUEUE_CONCURRENCY=10
QUEUE_MONITOR_INTERVAL=60000
QUEUE_MAX_ATTEMPTS=3

# Versão da API de Conversões do Facebook
FB_API_VERSION=v19.0 